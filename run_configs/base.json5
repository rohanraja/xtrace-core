{
    "name": "Chromium test in wave linux 4",
    "cr_path": "/workspace/cr_test", // Path to chromium source code, mostly "Q:/cr"
    "build_type": "release",
    "build_arch": "x64", // Build architecture, mostly "x64"
    "xtrace_server_port": 7004,
    "xtrace_server_ip": "20.244.33.135",
    "path_prefix_filter": "third_party/blink/", // If all files have common prefix, that can be removed from UI.
    "folders_whitelist": [ // List of folders which should be recorded
    ],
    "files_whitelist": [ // List of files which should be recorded
        "third_party/blink/renderer/core/editing/selection_controller.cc",
    ],
    "methods_which_split_run": [ // Methods from which we want to study code execution
        "HandleDoubleClick" 
    ],
    "methods_blacklist": [ // Methods which should not be parsed
        "InDifferentLinesOfSameInlineFormattingContext", 
    ],
    "should_skip_wpt_serve": true, // In case we don't want to run WPT server for web tests
    "run_filter": "", // If empty, run all steps otherwise comma separated list of steps to run
    "skipVariablesHooking": false, // Set to true to skip variable tracking (LocalVarUpdate calls) while preserving method entry and line logging
    "web_page": "double_click_test.html" // File in "run_configs/html" folder or an http link
}