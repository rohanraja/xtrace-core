{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "0) Install deps",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/install.js",
			],
		},
		{
			"label": "Install: use",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/install.user.js",
			],
		},
		{
			"label": "1) Parse inp.cc",
			"type": "shell",
			"command": "npm",
			"options": {
				"cwd": "${workspaceFolder}/hooks_injector/cpp_hooks_injector"
			},
			"args": [
				"run",
				"test"
			],
		},
		{
			"label": "A) Open tasks",
			"type": "shell",
			"command": "code",
			"args": [
				"docs/000 - Tasks.md",
			],
		},
		{
			"label": "Run.E2E",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/run.js",
				// "./run_configs/table_selection_bug.json5"
			],
		},
		{
			"label": "Run.GclientAndBuild",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/run.js",
				// "./run_configs/table_selection_bug.json5"
			],
			"options": {
				"env": {
					// "XT_RUN_FILTER": ""
					"XT_RUN_FILTER": "gclient, build-chrome, run-chrome"
				}
			}
		},
		{
			"label": "Run.Hook_Build.Tmux",
			"type": "shell",
			"command": "tmux has-session -t xtrun 2>/dev/null || tmux new-session -d -s xtrun; tmux new-window -t xtrun -n e2e_$(date +%s) 'XT_RUN_FILTER=copy-xtrace-lib,build-chrome node ./scripts/run.js; exec $SHELL'",
		},

		{
			"label": "Run.BuildChromeAndRun.Tmux",
			"type": "shell",
			"command": "tmux has-session -t xtrun 2>/dev/null || tmux new-session -d -s xtrun; tmux new-window -t xtrun -n e2e_$(date +%s) 'XT_RUN_FILTER=autogn-configure,build-chrome,run-chrome node ./scripts/run.js; exec $SHELL'",
		},

		{
			"label": "Run.BuildRunWebTest.Tmux",
			"type": "shell",
			"command": "tmux has-session -t xtrun 2>/dev/null || tmux new-session -d -s xtrun; tmux new-window -t xtrun -n e2e_$(date +%s) 'XT_RUN_FILTER=build-chrome,run-web-test node ./scripts/run.js; exec $SHELL'",
		},
		{
			"label": "Run.BuildRunTest.Tmux",
			"type": "shell",
			"command": "tmux has-session -t xtrun 2>/dev/null || tmux new-session -d -s xtrun; tmux new-window -t xtrun -n e2e_$(date +%s) 'XT_RUN_FILTER=build-chrome,run-tests node ./scripts/run.js; exec $SHELL'",
		},
		{
			"label": "Run.HookBuildRunTestUpload.Tmux",
			"type": "shell",
			"command": "tmux has-session -t xtrun 2>/dev/null || tmux new-session -d -s xtrun; tmux new-window -t xtrun -n e2e_$(date +%s) 'XT_RUN_FILTER=copy-xtrace-lib,build-chrome,run-tests,upload-recording node ./scripts/run.js; exec $SHELL'",
		},
		{
			"label": "Run.GclientBuild.Tmux",
			"type": "shell",
			"command": "tmux has-session -t xtrun 2>/dev/null || tmux new-session -d -s xtrun; tmux new-window -t xtrun -n e2e_$(date +%s) 'XT_RUN_FILTER=gclient,build-chrome,run-chrome node ./scripts/run.js; exec $SHELL'",
		},
		{
			"label": "Run.ALL",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/run.js",
				// "./run_configs/table_selection_bug.json5"
			],
			"options": {
				"env": {
					"XT_RUN_FILTER": ""
					// "XT_RUN_FILTER": "gclient, copy-xtrace-lib, cl-fetch, git-reset, inject-hooks, upload-source-code, build-webtest, build-chrome, run-web-test, run-chrome, upload-recording"
				}
			}
		},
		{
			"label": "Run.ReHookAndBuild",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/run.js",
				// "./run_configs/table_selection_bug.json5"
			],
			"options": {
				"env": {
					"XT_RUN_FILTER": "copy-xtrace-lib,git-reset,inject-hooks,upload-source-code,build-chrome"
				}
			}
		},
		{
			"label": "Run.ReHook",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/run.js",
				// "./run_configs/table_selection_bug.json5"
			],
			"options": {
				"env": {
					"XT_RUN_FILTER": "copy-xtrace-lib,git-reset,inject-hooks"
				}
			}
		},
		{
			"label": "Run.Hook-Build-Run-Upload_WebTest",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/run.js",
				// "./run_configs/table_selection_bug.json5"
			],
			"options": {
				"env": {
					"XT_RUN_FILTER": "copy-xtrace-lib,git-reset,inject-hooks,upload-source-code,build-webtest,run-web-test,upload-recording"
				}
			}
		},
		{
			"label": "Run.RunChromeAndUploadRecording",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/run.js",
				// "./run_configs/table_selection_bug.json5"
			],
			"options": {
				"env": {
					"XT_RUN_FILTER": "run-chrome,upload-recording"
				}
			}
		},
		{
			"label": "Run.Run-Upload_Webtest",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/run.js",
				// "./run_configs/table_selection_bug.json5"
			],
			"options": {
				"env": {
					"XT_RUN_FILTER": "run-web-test,upload-recording"
				}
			}
		},
		{
			"label": "Run.BrowserAndUpload",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/run.js",
				// "./run_configs/table_selection_bug.json5"
			],
			"options": {
				"env": {
					"XT_RUN_FILTER": "7,8"
				}
			}
		},
		{
			"label": "Run.OnlyBuild",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/run.js",
				// "./run_configs/table_selection_bug.json5"
			],
			"options": {
				"env": {
					"XT_RUN_FILTER": "build-chrome"
				}
			}
		},
		{
			"label": "C) Run CPP Injector UTs",
			"type": "shell",
			"command": "dotnet",
			"options": {
				"cwd": "${workspaceFolder}/hooks_injector/testing/HooksInjectorCommonTests"
			},
			"args": [
				"test",
			],
			"dependsOn": [
				"1) Parse inp.cc"
			]
		},
		{
			"label": "Config.SetActive",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/ui.js",
				"setActiveConfig",
				"${file}",
			],
			"problemMatcher": []
		},
		{
			"label": "Config.Add new",
			"type": "shell",
			"command": "node",
			"args": [
				"${workspaceFolder}/scripts/new_config_from_base.js",
				"${input:jsonFileName}"
			],
			"problemMatcher": []
		},
		{
			"label": "Add test cpp file",
			"type": "shell",
			"command": "node",
			"args": [
				"${workspaceFolder}/scripts/add_test_cpp_file.js",
				"${input:cppFileName}"
			],
			"problemMatcher": []
		},
		{
			"label": "Parse current file",
			"type": "shell",
			"command": "node",
			"args": [
				"${workspaceFolder}/scripts/parse_current_file.js",
				"${file}",
			],
			"problemMatcher": []
		},
		{
			"label": "D) Run JS Snapshot tests",
			"type": "shell",
			"command": "npm",
			"options": {
				"cwd": "${workspaceFolder}/hooks_injector/testing/snapshot-tester"
			},
			"args": [
				"test"
			],
		},
		{
			"label": "D.A) Update JS Snapshot tests",
			"type": "shell",
			"command": "npm",
			"options": {
				"cwd": "${workspaceFolder}/hooks_injector/testing/snapshot-tester"
			},
			"args": [
				"test",
				"--",
				"-u"
			],
		},
		{
			"label": "Serve console web",
			"type": "shell",
			"command": "npm",
			"options": {
				"cwd": "${workspaceFolder}/console-ui"
			},
			"args": [
				"run",
				"dev",
			],
		},
		{
			"label": "Logs.LastRun.Open",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/ui.js",
				"open_last_log",
			],
		},
		{
			"label": "Config.Active.Open",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/ui.js",
				"open_active_runconfig",
			],
		},
		{
			"label": "Recording.LastRun.Open",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/ui.js",
				"open_last_recording",
			],
		},
		{
			"label": "Code.Hooked.WhitelistFiles.Open",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/ui.js",
				"open_whitelist_files",
			],
		},
		{
			"label": "Code.Hooked.SrcDir.Open",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/ui.js",
				"open_src_dir",
			],
		},
		{
			"label": "Config.Create from CL",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/ui.js",
				"create_config_from_cl",
				"${input:clNumber}"
			],
		},
		{
			"label": "Hook.ActiveFile",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/ui.js",
				"hook_active_file",
				"${file}"
			],
		},
		{
			"label": "Logs.xTrace.Analyze",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/ui.js",
				"analyse_log",
			],
		},
		{
			"label": "Logs.xTrace.CodeOpen",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/ui.js",
				"open_xtrace_log",
			],
		},
		{
			"label": "Compile.ActiveFile",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/ui.js",
				"compile_run_active_file",
				"${file}"
			],
		},
		{
			"label": "Testing.HookAndRunFile.ActiveFile",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/ui.js",
				"hook_and_run_file",
				"${file}"
			],
		},
		{
			"label": "Run.Select..",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/run.js",
				// "./run_configs/table_selection_bug.json5"
			],
			"options": {
				"env": {
					"XT_RUN_FILTER": "${input:run_stage}"
				}
			}
		},
		{
			"label": "Run.E2E.Tmux",
			"type": "shell",
			"command": "tmux has-session -t xtrun 2>/dev/null || tmux new-session -d -s xtrun; tmux new-window -t xtrun -n e2e_$(date +%s) 'node ./scripts/run.js; exec $SHELL'",
		},
		{
			"label": "Docker.Build.CppHooksInjector",
			"type": "shell",
			"command": "docker",
			"args": [
				"build",
				"-t",
				"cpp-hooks-injector:latest",
				"."
			],
			"options": {
				"cwd": "${workspaceFolder}/hooks_injector/cpp_hooks_injector"
			},
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			}
		},
		{
			"label": "Docker.Run.CppHooksInjector",
			"type": "shell",
			"command": "docker",
			"args": [
				"run",
				"-it",
				"--rm",
				"-p",
				"3001:3001",
				"--name",
				"cpp-hooks-injector",
				"cpp-hooks-injector:latest"
			],
			"group": "test",
			"dependsOn": "Docker.Build.CppHooksInjector",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared"
			}
		},
	],
	"inputs": [
		{
			"id": "clNumber",
			"type": "promptString",
			"description": "Enter the CL number"
		},
		{
			"id": "cppFileName",
			"type": "promptString",
			"description": "Enter the name of the C++ file (without extension)"
		},
		{
			"id": "jsonFileName",
			"type": "promptString",
			"description": "Enter the name of JSON run config file"
		},
        {
            "id": "run_stage",
            "type": "pickString",
            "description": "Select a stage to run",
            "options": [
                "gclient",
                "copy-xtrace-lib",
                "cl-fetch",
                "git-reset",
                "inject-hooks",
                "upload-source-code",
                "build-webtest",
                "build-chrome",
                "run-web-test",
                "run-chrome",
                "upload-recording",
                "run-tests",
				"autogn-configure"
            ]
        }
	]
}