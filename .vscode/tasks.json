{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "0) Install deps",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/install.js",
			],
		},
		{
			"label": "Install: use",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/install.user.js",
			],
		},
		{
			"label": "1) Parse inp.cc",
			"type": "shell",
			"command": "npm",
			"options": {
				"cwd": "${workspaceFolder}/hooks_injector/cpp_hooks_injector"
			},
			"args": [
				"run",
				"test"
			],
		},
		{
			"label": "A) Open tasks",
			"type": "shell",
			"command": "code",
			"args": [
				"docs/000 - Tasks.md",
			],
		},
		{
			"label": "Run E2E automation",
			"type": "shell",
			"command": "node",
			"args": [
				"./scripts/run.js",
				// "./run_configs/table_selection_bug.json5"
			],
		},
		{
			"label": "C) Run CPP Injector UTs",
			"type": "shell",
			"command": "dotnet",
			"options": {
				"cwd": "${workspaceFolder}/hooks_injector/testing/HooksInjectorCommonTests"
			},
			"args": [
				"test",
			],
			"dependsOn": [
				"1) Parse inp.cc"
			]
		},
		{
			"label": "Add new run config",
			"type": "shell",
			"command": "node",
			"args": [
				"${workspaceFolder}/scripts/new_config_from_base.js",
				"${input:jsonFileName}"
			],
			"problemMatcher": []
		},
		{
			"label": "Add test cpp file",
			"type": "shell",
			"command": "node",
			"args": [
				"${workspaceFolder}/scripts/add_test_cpp_file.js",
				"${input:cppFileName}"
			],
			"problemMatcher": []
		},
		{
			"label": "Parse current file",
			"type": "shell",
			"command": "node",
			"args": [
				"${workspaceFolder}/scripts/parse_current_file.js",
				"${file}",
			],
			"problemMatcher": []
		},
		{
			"label": "D) Run JS Snapshot tests",
			"type": "shell",
			"command": "npm",
			"options": {
				"cwd": "${workspaceFolder}/hooks_injector/testing/snapshot-tester"
			},
			"args": [
				"test"
			],
		},
		{
			"label": "D.A) Update JS Snapshot tests",
			"type": "shell",
			"command": "npm",
			"options": {
				"cwd": "${workspaceFolder}/hooks_injector/testing/snapshot-tester"
			},
			"args": [
				"test",
				"--",
				"-u"
			],
		},
		{
			"label": "Open last run logs",
			"type": "shell",
			"command": "code",
			"args": [
				"tmp/lastRun.log",
			],
		},
	],
	"inputs": [
		{
			"id": "cppFileName",
			"type": "promptString",
			"description": "Enter the name of the C++ file (without extension)"
		},
		{
			"id": "jsonFileName",
			"type": "promptString",
			"description": "Enter the name of JSON run config file"
		}
	]
}